@page "/budgets"
@namespace FinTrack.Client.Pages
@inject IFinTrackApiService ApiService
@implements IDisposable

<div class="budgets-page">
    <!-- Monthly Budgets Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
        <h1 class="section-title" style="margin: 0;">Monthly Budgets</h1>
        <button class="icon-button" @onclick="OpenAddBudget" title="Add Monthly Budget" style="background: #E2E8F0; width: 34px; height: 34px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        </button>
    </div>

    @foreach (var b in budgets)
    {
        var percent = b.Limit > 0 ? Math.Round((double)(b.Spent / b.Limit) * 100.0, 0) : 0;
        <div class="budget-card" @onclick="() => OpenEditBudget(b)" style="cursor: pointer;">
            <div class="budget-header">
                <div class="budget-category-info">
                    <div class="category-icon-circle mint" style="width: 40px; height: 40px;">
                        @((MarkupString)GetBudgetCategoryIcon(b.CategoryName))
                    </div>
                    <span class="budget-category-name">@b.CategoryName</span>
                </div>
                <span class="budget-percent-pill">@percent%</span>
            </div>

            <div class="budget-amount-row">
                <span class="budget-amount-spent">@b.Spent.ToString("C0")</span>
                <span class="budget-amount-limit">/ @b.Limit.ToString("C0")</span>
            </div>

            <div class="progress-track">
                <div class="progress-fill @(percent >= 80 ? "red" : "green")" style="width: @Math.Min(100, percent)%"></div>
            </div>
        </div>
    }

    <!-- Savings Goals Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin: 24px 0 14px 0;">
        <h2 class="section-title" style="margin: 0;">Savings Goals</h2>
        <div style="display: flex; align-items: center; gap: 8px;">
            <button class="icon-button" @onclick="OpenAddGoal" title="Add Savings Goal" style="background: #E2E8F0; width: 34px; height: 34px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>
            <span class="card-action-link" style="font-size: 14px; font-weight: 600;">View All</span>
        </div>
    </div>

    @foreach (var g in savingsGoals)
    {
        <div class="savings-card">
            <div class="savings-header" @onclick="() => OpenEditGoal(g)" style="cursor: pointer;">
                <div class="category-icon-circle @GetSavingsColorClass(g.Name)" style="width: 44px; height: 44px;">
                    @((MarkupString)GetSavingsIcon(g.Name))
                </div>
                <div>
                    <div class="savings-name">@g.Name</div>
                    <div class="savings-subtext">@g.ProgressPercent.ToString("0.#")% Achieved</div>
                </div>
            </div>

            <div class="savings-amount-row">
                <span class="savings-current">@g.CurrentAmount.ToString("C0")</span>
                <span class="savings-target">of @g.TargetAmount.ToString("C0")</span>
            </div>

            <div class="progress-track">
                <div class="progress-fill green" style="width: @Math.Min(100, g.ProgressPercent)%"></div>
            </div>

            <button class="btn-contribute-inline" @onclick="() => OpenContributeModal(g)">
                + Contribute
            </button>
        </div>
    }
</div>

<BudgetModal @bind-IsOpen="isBudgetModalOpen" BudgetToEdit="selectedBudget" OnSaved="LoadData" />
<SavingsModal @bind-IsOpen="isSavingsModalOpen" GoalToEdit="selectedGoal" IsContribute="isContributeMode" OnSaved="LoadData" />

@code {
    private List<BudgetDto> budgets = new();
    private List<SavingsGoalDto> savingsGoals = new();

    private bool isBudgetModalOpen;
    private BudgetDto? selectedBudget;

    private bool isSavingsModalOpen;
    private SavingsGoalDto? selectedGoal;
    private bool isContributeMode;

    protected override async Task OnInitializedAsync()
    {
        ApiService.OnDataChanged += HandleDataChanged;
        await LoadData();
    }

    private async Task LoadData()
    {
        budgets = await ApiService.GetBudgetsAsync();
        savingsGoals = await ApiService.GetSavingsGoalsAsync();
        StateHasChanged();
    }

    private void HandleDataChanged()
    {
        InvokeAsync(async () => await LoadData());
    }

    private void OpenAddBudget()
    {
        selectedBudget = null;
        isBudgetModalOpen = true;
    }

    private void OpenEditBudget(BudgetDto b)
    {
        selectedBudget = b;
        isBudgetModalOpen = true;
    }

    private void OpenAddGoal()
    {
        selectedGoal = null;
        isContributeMode = false;
        isSavingsModalOpen = true;
    }

    private void OpenEditGoal(SavingsGoalDto g)
    {
        selectedGoal = g;
        isContributeMode = false;
        isSavingsModalOpen = true;
    }

    private void OpenContributeModal(SavingsGoalDto g)
    {
        selectedGoal = g;
        isContributeMode = true;
        isSavingsModalOpen = true;
    }

    private string GetBudgetCategoryIcon(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("food") || lower.Contains("grocer"))
        {
            // Fork and knife
            return @"<svg width=""18"" height=""18"" viewBox=""0 0 24 24"" fill=""none"" stroke=""#047857"" stroke-width=""2"">
                <path d=""M18 2v6a3 3 0 0 1-3 3 3 3 0 0 1-3-3V2""></path>
                <path d=""M15 2v10""></path>
                <path d=""M15 12v10""></path>
                <path d=""M6 2v20""></path>
                <path d=""M6 2a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3""></path></svg>";
        }
        if (lower.Contains("transport") || lower.Contains("car") || lower.Contains("uber"))
        {
            // Car icon
            return @"<svg width=""18"" height=""18"" viewBox=""0 0 24 24"" fill=""none"" stroke=""#047857"" stroke-width=""2"">
                <rect x=""2"" y=""7"" width=""20"" height=""14"" rx=""2""></rect>
                <circle cx=""7"" cy=""17"" r=""2""></circle><circle cx=""17"" cy=""17"" r=""2""></circle></svg>";
        }
        // Entertainment / film slate icon
        return @"<svg width=""18"" height=""18"" viewBox=""0 0 24 24"" fill=""none"" stroke=""#047857"" stroke-width=""2"">
            <rect x=""2"" y=""4"" width=""20"" height=""16"" rx=""2""></rect>
            <path d=""M2 8h20""></path><path d=""m6 4 3 4""></path><path d=""m15 4 3 4""></path></svg>";
    }

    private string GetSavingsColorClass(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("emergency") || lower.Contains("shield")) return "orange";
        if (lower.Contains("vacation") || lower.Contains("travel") || lower.Contains("plane")) return "blue";
        return "slate";
    }

    private string GetSavingsIcon(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("emergency"))
        {
            // Shield icon
            return @"<svg width=""20"" height=""20"" viewBox=""0 0 24 24"" fill=""none"" stroke=""#EA580C"" stroke-width=""2"">
                <path d=""M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z""></path>
                <path d=""M12 8v4""></path><path d=""M12 16h.01""></path></svg>";
        }
        if (lower.Contains("vacation") || lower.Contains("travel"))
        {
            // Airplane icon
            return @"<svg width=""20"" height=""20"" viewBox=""0 0 24 24"" fill=""none"" stroke=""#0284C7"" stroke-width=""2"">
                <path d=""M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z""></path></svg>";
        }
        return @"<svg width=""20"" height=""20"" viewBox=""0 0 24 24"" fill=""none"" stroke=""#475569"" stroke-width=""2""><circle cx=""12"" cy=""12"" r=""10""></circle></svg>";
    }

    public void Dispose()
    {
        ApiService.OnDataChanged -= HandleDataChanged;
    }
}
