@page "/register"
@namespace FinTrack.Client.Pages
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="auth-page-container">
    <div class="auth-header-logo">
        <div class="category-icon-circle mint" style="width: 54px; height: 54px; margin: 0 auto 12px auto;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
        </div>
        <h1 class="page-main-title" style="text-align: center; margin-bottom: 4px;">Create Account</h1>
        <p class="page-subtitle" style="text-align: center; margin-bottom: 24px;">Start taking control of your finances</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-error-alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@errorMessage</span>
        </div>
    }

    <div class="fintrack-card">
        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control-input" @bind-value="registerModel.FullName" placeholder="e.g. Lucas Hood" required />
            </div>

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control-input" @bind-value="registerModel.Email" placeholder="e.g. lucas@ug.edu.gh" required />
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <input type="password" class="form-control-input" @bind-value="registerModel.Password" placeholder="Minimum 6 characters" required />
            </div>

            <button type="submit" class="btn-primary-action" disabled="@isLoading" style="margin-top: 18px;">
                @(isLoading ? "Creating account..." : "Sign Up")
            </button>
        </EditForm>
    </div>

    <div style="text-align: center; margin-top: 20px; font-size: 14px; color: var(--text-muted);">
        Already have an account? 
        <NavLink href="login" class="card-action-link" style="color: var(--primary-green-dark); font-weight: 700;">Sign in</NavLink>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var auth = await AuthService.RegisterAsync(registerModel);
            if (auth != null)
            {
                Nav.NavigateTo("");
            }
            else
            {
                errorMessage = "Unable to create account. Please check your inputs.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
