@inherits LayoutComponentBase
@namespace FinTrack.Client.Layout
@inject NavigationManager Nav
@inject IAuthService AuthService
@implements IDisposable

<div class="app-viewport">
    <div class="app-frame">
        @if (!IsAuthPage && isAuthenticated)
        {
            <AppHeader />
        }
        
        <main class="app-main-content @(IsAuthPage ? "auth-main-content" : "")">
            @if (IsAuthPage || isAuthenticated)
            {
                @Body
            }
        </main>

        @if (!IsAuthPage && isAuthenticated)
        {
            <BottomNav />
        }
    </div>
</div>

@code {
    private bool isAuthenticated;

    private bool IsAuthPage
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
            return path.StartsWith("login") || path.StartsWith("register");
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAuthGuardAsync();
    }

    private async Task CheckAuthGuardAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!IsAuthPage && !isAuthenticated)
        {
            Nav.NavigateTo("login");
            return;
        }
        StateHasChanged();
    }

    private void HandleAuthStateChanged()
    {
        InvokeAsync(async () =>
        {
            await CheckAuthGuardAsync();
        });
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            await CheckAuthGuardAsync();
        });
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}
