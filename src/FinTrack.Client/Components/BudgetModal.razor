@namespace FinTrack.Client.Components
@inject IFinTrackApiService ApiService

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-sheet" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(IsEdit ? "Update Budget" : "New Category Budget")</h3>
                <button class="modal-close-btn" @onclick="Close" title="Close" disabled="@isLoading">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="modal-alert-error" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>@errorMessage</span>
                    <button type="button" class="modal-alert-close-btn" @onclick="() => errorMessage = null">✕</button>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (!IsEdit)
                {
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select class="form-control-select" @bind="model.CategoryId" disabled="@isLoading" required>
                            <option value="@Guid.Empty">-- Select Category --</option>
                            @foreach (var cat in categories.Where(c => c.Type == "Expense"))
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Monthly Limit (GH₵)</label>
                    <input type="number" step="1" min="1" class="form-control-input" @bind-value="model.Limit" placeholder="500" disabled="@isLoading" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Month (YYYY-MM)</label>
                    <input type="text" class="form-control-input" @bind-value="model.Month" placeholder="e.g. 2026-08" disabled="@isLoading" required />
                </div>

                <button type="submit" class="btn-primary-action" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-inline"></span>
                        <span>@(IsEdit ? "Saving Budget..." : "Creating Budget...")</span>
                    }
                    else
                    {
                        <span>@(IsEdit ? "Save Budget" : "Create Budget")</span>
                    }
                </button>

                @if (IsEdit)
                {
                    <button type="button" class="btn-danger-action" @onclick="HandleDelete" disabled="@isLoading">
                        @if (isDeleting)
                        {
                            <span class="spinner-inline"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Delete Budget</span>
                        }
                    </button>
                }
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public BudgetDto? BudgetToEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool IsEdit => BudgetToEdit != null;
    private CreateBudgetRequest model = new() { Month = DateTime.Today.ToString("yyyy-MM") };
    private List<CategoryDto> categories = new();
    private bool isLoading;
    private bool isDeleting;
    private string? errorMessage;
    private bool wasOpen;
    private Guid? previousBudgetId;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            bool isNewOpen = !wasOpen;
            bool isDifferentBudget = BudgetToEdit?.Id != previousBudgetId;

            if (isNewOpen || isDifferentBudget)
            {
                errorMessage = null;
                try
                {
                    categories = await ApiService.GetCategoriesAsync();
                }
                catch (Exception ex)
                {
                    errorMessage = $"Failed to load categories: {ex.Message}";
                }

                if (BudgetToEdit != null)
                {
                    model = new CreateBudgetRequest
                    {
                        CategoryId = BudgetToEdit.CategoryId,
                        Limit = BudgetToEdit.Limit,
                        Month = BudgetToEdit.Month
                    };
                }
                else
                {
                    model = new CreateBudgetRequest
                    {
                        CategoryId = categories.FirstOrDefault(c => c.Type == "Expense")?.Id ?? Guid.Empty,
                        Limit = 500,
                        Month = DateTime.Today.ToString("yyyy-MM")
                    };
                }
            }
        }
        else
        {
            errorMessage = null;
            isLoading = false;
        }

        wasOpen = IsOpen;
        previousBudgetId = BudgetToEdit?.Id;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            if (IsEdit && BudgetToEdit != null)
            {
                await ApiService.UpdateBudgetAsync(BudgetToEdit.Id, new UpdateBudgetRequest
                {
                    Limit = model.Limit
                });
            }
            else
            {
                if (model.CategoryId == Guid.Empty)
                {
                    errorMessage = "Please select a category.";
                    isLoading = false;
                    return;
                }
                await ApiService.CreateBudgetAsync(model);
            }

            await OnSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDelete()
    {
        if (BudgetToEdit != null)
        {
            errorMessage = null;
            isLoading = true;
            isDeleting = true;
            try
            {
                await ApiService.DeleteBudgetAsync(BudgetToEdit.Id);
                await OnSaved.InvokeAsync();
                await Close();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
            finally
            {
                isLoading = false;
                isDeleting = false;
            }
        }
    }

    private async Task Close()
    {
        if (isLoading) return;
        errorMessage = null;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
