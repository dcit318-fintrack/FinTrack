@namespace FinTrack.Client.Components
@inject IFinTrackApiService ApiService

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-sheet" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(IsEdit ? "Edit Transaction" : "New Transaction")</h3>
                <button class="modal-close-btn" @onclick="Close" title="Close">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 8px; background-color: #FEE2E2; color: #991B1B; font-size: 13px;">
                    @errorMessage
                </div>
            }

            <!-- Type toggle -->
            <div class="type-toggle-group">
                <button type="button" class="type-toggle-btn @(model.Type == "Expense" ? "active expense" : "")" 
                        @onclick='() => ChangeType("Expense")'>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                    Expense
                </button>
                <button type="button" class="type-toggle-btn @(model.Type == "Income" ? "active income" : "")" 
                        @onclick='() => ChangeType("Income")'>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="7" y1="7" x2="17" y2="17"></line>
                        <polyline points="17 7 17 17 7 17"></polyline>
                    </svg>
                    Income
                </button>
            </div>

            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label">Amount (GH₵)</label>
                    <input type="number" step="0.01" min="0.01" class="form-control-input" @bind-value="model.Amount" placeholder="0.00" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select class="form-control-select" @bind="model.CategoryId" required>
                        <option value="@Guid.Empty">-- Select Category --</option>
                        @foreach (var cat in FilteredCategories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control-input" @bind-value="model.Description" placeholder="e.g. Whole Foods, Starbucks, Salary" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Date</label>
                    <input type="datetime-local" class="form-control-input" @bind-value="model.Date" required />
                </div>

                <button type="submit" class="btn-primary-action" disabled="@isSubmitting">
                    @(isSubmitting ? "Saving..." : (IsEdit ? "Save Changes" : "Add Transaction"))
                </button>

                @if (IsEdit)
                {
                    <button type="button" class="btn-danger-action" @onclick="HandleDelete" disabled="@isSubmitting">
                        Delete Transaction
                    </button>
                }
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public TransactionDto? TransactionToEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool IsEdit => TransactionToEdit != null;
    private CreateTransactionRequest model = new() { Type = "Expense", Date = DateTime.Now };
    private List<CategoryDto> categories = new();
    private string? errorMessage;
    private bool isSubmitting;

    private IEnumerable<CategoryDto> FilteredCategories =>
        categories.Where(c => string.Equals(c.Type, model.Type, StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(c.Name, "Other", StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(c.Type, "All", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            errorMessage = null;
            isSubmitting = false;
            try
            {
                categories = await ApiService.GetCategoriesAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to load categories: {ex.Message}";
            }

            if (TransactionToEdit != null)
            {
                model = new CreateTransactionRequest
                {
                    Amount = TransactionToEdit.Amount,
                    Type = TransactionToEdit.Type,
                    CategoryId = TransactionToEdit.CategoryId,
                    Description = TransactionToEdit.Description,
                    Date = TransactionToEdit.Date
                };
            }
            else
            {
                model = new CreateTransactionRequest
                {
                    Amount = 0,
                    Type = "Expense",
                    CategoryId = FilteredCategories.FirstOrDefault()?.Id ?? Guid.Empty,
                    Description = string.Empty,
                    Date = DateTime.Now
                };
            }
        }
    }

    private void ChangeType(string newType)
    {
        model.Type = newType;
        if (!FilteredCategories.Any(c => c.Id == model.CategoryId))
        {
            model.CategoryId = FilteredCategories.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        if (model.CategoryId == Guid.Empty && FilteredCategories.Any())
        {
            model.CategoryId = FilteredCategories.First().Id;
        }

        try
        {
            if (IsEdit && TransactionToEdit != null)
            {
                await ApiService.UpdateTransactionAsync(TransactionToEdit.Id, new UpdateTransactionRequest
                {
                    Amount = model.Amount,
                    Type = model.Type,
                    CategoryId = model.CategoryId,
                    Description = model.Description,
                    Date = model.Date
                });
            }
            else
            {
                await ApiService.CreateTransactionAsync(model);
            }

            await OnSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleDelete()
    {
        if (TransactionToEdit != null)
        {
            errorMessage = null;
            isSubmitting = true;
            try
            {
                await ApiService.DeleteTransactionAsync(TransactionToEdit.Id);
                await OnSaved.InvokeAsync();
                await Close();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
            finally
            {
                isSubmitting = false;
            }
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
