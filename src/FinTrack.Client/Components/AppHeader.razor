@namespace FinTrack.Client.Components

<header class="app-header">
    <div class="app-header-left">
        <img src="images/avatar.svg" alt="User Profile" class="app-avatar" />
    </div>
    <div class="app-header-center">
        <span class="app-brand-title">Fintrack</span>
    </div>
    <div class="app-header-right">
        <button class="icon-button" @onclick="ToggleNotifications" title="Notifications" aria-label="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            @if (hasUnreadNotifications)
            {
                <span class="notification-badge"></span>
            }
        </button>
    </div>
</header>

@code {
    private bool hasUnreadNotifications = true;

    private void ToggleNotifications()
    {
        hasUnreadNotifications = !hasUnreadNotifications;
    }
}
